# Secreto para firmar los JWT de sesión (base64, 256+ bits). Ya tiene un default de desarrollo
# en application.yml; solo hace falta sobreescribirlo antes de ir a producción.
#SIFEN_SECURITY_JWT_SECRET=

# Orígenes permitidos por CORS, si el frontend corre en otro host/puerto (default: localhost:5173).
#SIFEN_CORS_ALLOWED_ORIGINS=http://localhost:5173

# Carpeta donde el stub de email escribe el PDF/XML/resumen simulado.
#SIFEN_EMAIL_OUTBOX_DIR=./emails-simulados

# "stub" (default, sin red real) o "real" (SOAP real contra el ambiente de prueba del SIFEN).
SIFEN_ENVIO_MODO=stub

# Certificado digital (.pfx/PKCS12) del contribuyente, usado para TLS mutuo y (más adelante) firma.
#SIFEN_FIRMA_KEYSTORE_PATH=C:\ruta\al\certificado.pfx
#SIFEN_FIRMA_KEYSTORE_PASSWORD=
#SIFEN_FIRMA_KEY_ALIAS=

# Los datos del emisor (RUC, dirección, actividad económica, timbrado) ya no van acá: se cargan en
# la pantalla "Configuración del emisor". El establecimiento/punto de expedición se elige en cada factura.

# Código de seguridad del contribuyente (CSC) para el QR del DE. Lo entrega la SET al habilitarte;
# el default es el valor de ejemplo del Manual Técnico, solo para el ambiente de test.
#SIFEN_QR_ID_CSC=0001
#SIFEN_QR_CSC=ABCD0000000000000000000000000000

#SIFEN_ENVIO_TIMEOUT_SEGUNDOS=30
#SIFEN_ENVIO_HISTORIAL_PATH=./sifen-envios-historial.jsonl

# WS de consulta de RUC del SIFEN (prueba de conectividad, GET /api/sifen/consulta-ruc/{ruc}).
#SIFEN_ENVIO_URL_CONSULTA_RUC=https://sifen-test.set.gov.py/de/ws/consultas/consulta-ruc.wsdl

# Conexión a la base, si Postgres no está en localhost:5432 (ej. Postgres 18 en 5434).
#SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/sifen_db
