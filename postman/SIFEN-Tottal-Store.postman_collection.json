  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "function calcularDv(base) {",
          "  let total = 0, peso = 2;",
          "  for (let i = base.length - 1; i >= 0; i--) {",
          "    total += parseInt(base[i], 10) * peso;",
          "    peso = peso === 11 ? 2 : peso + 1;",
          "  }",
          "  const resto = total % 11;",
          "  return resto > 1 ? 11 - resto : 0;",
          "}",
          "if (!pm.collectionVariables.get('runId')) {",
          "  const runId = Date.now().toString().slice(-6);",
          "  pm.collectionVariables.set('runId', runId);",
          "  pm.collectionVariables.set('clienteRucGenerado', `${runId}-${calcularDv(runId)}`);",
          "  const runIdFactura = runId.split('').reverse().join('');",
          "  pm.collectionVariables.set('clienteRucGeneradoFactura', `${runIdFactura}-${calcularDv(runIdFactura)}`);",
          "}"
        ]
      }
    }
  ]
