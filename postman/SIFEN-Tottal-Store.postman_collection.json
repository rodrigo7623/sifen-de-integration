{
  "info": {
    "name": "SIFEN Manager - Tottal Store",
    "description": "Coleccion para probar el backend (Release 1): auth, catalogo, clientes, facturacion manual y ABM de usuarios. Correr primero 'Login' (guarda el token automaticamente); el resto de las carpetas usan Bearer Auth heredado de la coleccion. Cada corrida genera codigo/RUC/email unicos (runId), por lo que la coleccion completa se puede correr repetidas veces sin conflictos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "clienteRuc",
      "value": "80012345-0"
    },
    {
      "key": "productoCodigo",
      "value": "TLD-220V"
    },
    {
      "key": "facturaId",
      "value": ""
    },
    {
      "key": "usuarioId",
      "value": ""
    },
    {
      "key": "clienteRucFactura",
      "value": ""
    },
    {
      "key": "productoCodigoFactura",
      "value": ""
    },
    {
      "key": "facturaIdRechazo",
      "value": ""
    },
    {
      "key": "establecimientoIdFactura",
      "value": ""
    },
    {
      "key": "puntoExpedicionIdFactura",
      "value": ""
    },
    {
      "key": "establecimientoIdNuevo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const loginData = pm.response.json();",
                  "pm.collectionVariables.set('token', loginData.token);",
                  "pm.test('login ok, token guardado', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tottalstore.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
